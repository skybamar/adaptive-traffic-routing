{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "adaptive-traffic-routing",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "vars": {
    "ORIGIN_URL": "http://localhost:9000",
    "DEBUG": "true"
  },
  "kv_namespaces": [
    { "binding": "STATE", "id": "state" }
  ]
}
